{
    "name": "teepay/teepay-php",
    "description": "Official PHP SDK for the TeePay payments API: mobile money collections, hosted checkout, Control Numbers, payouts and webhook verification.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "teepay",
        "payments",
        "mobile money",
        "checkout",
        "tanzania",
        "africa",
        "webhooks"
    ],
    "homepage": "https://docs.teepay.me/docs/sdks/php",
    "support": {
        "docs": "https://docs.teepay.me/docs/sdks/php",
        "issues": "https://github.com/kraftonnotgar-spec/teepay-php/issues",
        "source": "https://github.com/kraftonnotgar-spec/teepay-php"
    },
    "authors": [
        {
            "name": "TeePay",
            "homepage": "https://teepay.me"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-hash": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "TeePay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TeePay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
